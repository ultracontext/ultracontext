{
    "name": "ultracontext",
    "description": "JavaScript/TypeScript SDK + CLI for the UltraContext API",
    "type": "module",
    "version": "1.5.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "prepack": "pnpm run build",
        "test": "node --test tests/**/*.test.mjs"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ultracontext/ultracontext.git",
        "directory": "apps/js-sdk"
    },
    "author": "Ultracontext",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/ultracontext/ultracontext/issues"
    },
    "homepage": "https://ultracontext.ai",
    "keywords": [
        "ai",
        "llm",
        "context",
        "agents",
        "ai-agents",
        "context-engineering",
        "context-management",
        "context-window",
        "versioning",
        "time-travel",
        "rollback",
        "chat",
        "conversation",
        "typescript"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "files": [
        "dist/"
    ],
    "dependencies": {
        "fast-glob": "^3.3.3"
    },
    "devDependencies": {
        "@ultracontext/parsers": "workspace:*",
        "tsdown": "^0.20.3",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.28.1"
}
